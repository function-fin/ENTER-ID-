-- --- FUNÇÃO PARA ARRASTAR ELEMENTOS (PC E MOBILE) ---

local function ConfigurarArrastar(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

ConfigurarArrastar(FloatingButton)
ConfigurarArrastar(MainFrame)


-- --- LÓGICA DE INJEÇÃO MODO ALL ---

local function AoProcessarID(idString)
    local idLimpo = idString:gsub("%D", "")
    local idNum = tonumber(idLimpo)
    
    if not idNum or idNum == 0 then return end

    -- 1. Execução via Wear Remote do Brookhaven
    if wearRemote then
        pcall(function()
            wearRemote:InvokeServer(idNum)
        end)
    end

    -- 2. Métodos secundários de sincronia do jogo
    if remotesFolder then
        local refreshRemote = remotesFolder:FindFirstChild("RefreshCharacter")
        local bodyRemote = remotesFolder:FindFirstChild("ChangeCharacterBody")
        
        if refreshRemote then
            pcall(function()
                refreshRemote:FireServer({[tostring(idNum)] = true})
            end)
        end
        if bodyRemote then
            pcall(function()
                local bodyParts = {idNum, idNum, idNum, idNum, idNum}
                bodyRemote:InvokeServer(unpack({bodyParts}))
            end)
        end
    end

    -- 3. Executor direto local para animações cruas
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")

    if animator then
        pcall(function()
            if currentTrack then currentTrack:Stop() end
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. idNum
            currentTrack = animator:LoadAnimation(anim)
            currentTrack.Priority = Enum.AnimationPriority.Action4
            currentTrack.Looped = true
            currentTrack:Play()
        end)
    end
end


