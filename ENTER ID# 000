-- Limpa a caixa ao clicar nela para digitar
TextBox.Focused:Connect(function()
    if TextBox.Text == "Enter ID#" then
        TextBox.Text = ""
    end
end)

-- Gerencia a perda de foco (Ao apertar enter ou clicar fora)
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local idDigitado = TextBox.Text
        if idDigitado ~= "" and idDigitado ~= "Enter ID#" then
            AoProcessarID(idDigitado)
        end
    end
    
    -- Força o texto "Enter ID#" a voltar sempre que o jogador terminar a ação
    TextBox.Text = "Enter ID#"
end)
